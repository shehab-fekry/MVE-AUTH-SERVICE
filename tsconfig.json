{
  "compilerOptions": {
    "noImplicitAny": false,
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true, // Enable importing .json modules
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "src/**/*.js"] // Include all TypeScript and JavaScript files in the src directory
}
