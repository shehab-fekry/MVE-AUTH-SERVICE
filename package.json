{
  "name": "template",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "app.ts",
  "scripts": {
    "format": "prettier --write 'src/**/*.ts' 'scripts/**/*.{js,ts}'",
    "precommit": "bun run lint && bun run typecheck && bun run build",
    "preinstall": "npx only-allow bun",
    "prepare": "bun run husky install",
    "dev": "bun --watch src/app.ts",
    "start": "node dist/app.js",
    "lint": "eslint 'src/**/*.ts' 'scripts/**/*.{js,ts}'",
    "typecheck": "tsc --noEmit",
    "build": "bun run swagger bun run lint && bun run tsc",
    "swagger": "bun src/libs/swagger-autogen.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "ejs": "^4.0.1",
    "express": "^5.2.1",
    "ioredis": "^5.9.2",
    "morgan": "^1.10.1",
    "nodemailer": "^7.0.12",
    "prisma": "6.19",
    "swagger-ui-express": "^5.0.1",
    "swagger-autogen": "^2.23.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/morgan": "^1.9.10",
    "@types/ejs": "^3.1.5",
    "@types/nodemailer": "^7.0.5",
    "@types/node": "^25.0.9",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.1.3",
  "engines": {
    "yarn": "please-use-bun",
    "npm": "please-use-bun",
    "bun": ">= 1.1.0"
  }
}
