<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Activate Your Seller Account</title>
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />
  </head>

  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #ffffff;
      font-family: Arial, Helvetica, sans-serif;
    "
  >
    <table
      width="100%"
      cellpadding="0"
      cellspacing="0"
      style="padding: 24px 0"
    >
      <tr>
        <td align="center">
          <!-- Main container -->
          <table
            width="600"
            cellpadding="0"
            cellspacing="0"
            style="
              background: #ffffff;
              border-radius: 8px;
              overflow: hidden;
            "
          >
            <!-- Header -->
            <tr>
              <td
                style="
                  background: #e9e9e7;
                  padding: 24px;
                  text-align: center;
                "
              >
                <h1
                  style="margin: 0; color: #1c1b1f; font-size: 24px"
                >
                  Activate Your Account
                </h1>
              </td>
            </tr>

            <!-- Content -->
            <tr>
              <td style="padding: 32px">
                <p
                  style="
                    margin: 0 0 16px;
                    font-size: 16px;
                    color: #1c1b1f;
                  "
                >
                  Hi <strong><%= name %></strong>,
                </p>

                <p
                  style="
                    margin: 0 0 16px;
                    font-size: 15px;
                    color: #374151;
                    line-height: 1.6;
                  "
                >
                  Thanks for joining our platform as a seller! You're
                  just one step away from setting up your store and
                  reaching customers.
                </p>

                <p
                  style="
                    margin: 0 0 16px;
                    font-size: 15px;
                    color: #1c1b1f;
                    line-height: 1.6;
                  "
                >
                  To activate your seller account, please use the
                  One-Time Password (OTP) below:
                </p>

                <!-- OTP box -->
                <div style="margin: 24px 0; text-align: center">
                  <span
                    style="
                      display: inline-block;
                      padding: 14px 28px;
                      font-size: 24px;
                      letter-spacing: 4px;
                      font-weight: bold;
                      background: #e9e9e7;
                      color: #1c1b1f;
                      border-radius: 6px;
                    "
                  >
                    <%= otp %>
                  </span>
                </div>

                <p
                  style="
                    margin: 0 0 16px;
                    font-size: 14px;
                    color: #374151;
                    line-height: 1.6;
                  "
                >
                  This OTP is valid for a limited time. Once verified,
                  you’ll be able to access your seller dashboard and
                  start listing your products.
                </p>

                <p
                  style="
                    margin: 0 0 16px;
                    font-size: 14px;
                    color: #374151;
                    line-height: 1.6;
                  "
                >
                  If you didn’t request this, you can safely ignore
                  this email.
                </p>

                <p
                  style="
                    margin: 24px 0 0;
                    font-size: 14px;
                    color: #1c1b1f;
                  "
                >
                  Wishing you great sales,
                  <br />
                  <strong>ONRUSH Team</strong>
                </p>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td
                style="
                  background: #e9e9e7;
                  padding: 16px;
                  text-align: center;
                "
              >
                <p style="margin: 0; font-size: 12px; color: #1c1b1f">
                  © <%= new Date().getFullYear() %> ONRUSH. All rights
                  reserved.
                </p>
                <p
                  style="
                    margin: 8px 0 0;
                    font-size: 12px;
                    color: #1c1b1f;
                  "
                >
                  Please do not reply to this email.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
